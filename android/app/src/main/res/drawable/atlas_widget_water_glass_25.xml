<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="bottom" android:height="18dp">
        <shape>
            <corners
                android:bottomLeftRadius="14dp"
                android:bottomRightRadius="14dp" />
            <gradient
                android:angle="90"
                android:endColor="#9DCCFF"
                android:startColor="#D8EEFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners
                android:bottomLeftRadius="14dp"
                android:bottomRightRadius="14dp"
                android:topLeftRadius="7dp"
                android:topRightRadius="7dp" />
            <solid android:color="#0018A0FF" />
            <stroke
                android:width="2dp"
                android:color="#86B8F6" />
        </shape>
    </item>
</layer-list>
